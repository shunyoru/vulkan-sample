{
    // ── 語義著色 ──────────────────────────────────────────────
    // 啟用語義 token，讓 VSCode 根據程式碼的語意（而非語法）上色
    "editor.semanticHighlighting.enabled": true,

    "editor.semanticTokenColorCustomizations": {
        "rules": {
            // 類別成員變數（instance variables）→ 淡藍色
            "property": "#9CDCFE",
            // 成員函式 → 淡黃色
            "method": "#DCDCAA",
            // 靜態成員 → 加底線
            "property.static": {
                "foreground": "#9CDCFE",
                "fontStyle": "underline"
            }
        }
    }
}
